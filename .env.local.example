# Supabase (회원가입/로그인 + 즐겨찾기 저장)
# 발급: supabase.com 프로젝트 → Connect 버튼 → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 점수 히스토리 적재(npm run refresh)용. Row Level Security를 우회하는 키라
# 브라우저에 노출되면 남이 내 DB를 마음대로 고칠 수 있습니다. NEXT_PUBLIC_ 접두사를
# 붙이지 마세요 — 붙이면 Next.js가 클라이언트 번들에 그대로 넣습니다.
# 발급: Supabase 프로젝트 → Project Settings → API Keys → service_role
# 배포(Vercel)에는 넣을 필요가 없습니다. 배치에서만 씁니다.
SUPABASE_SERVICE_ROLE_KEY=
