# ============================================================================
# Supabase — 회원가입/로그인 및 즐겨찾기 저장 (선택사항, 회원 기능 비활성화 가능)
# ============================================================================
# 값을 비우면 회원가입·로그인이 동작하지 않고, 스크리너와 종목 상세는 그대로 열립니다.
# MY Page(즐겨찾기)와 로그인 기능만 비활성화됩니다.

# Supabase 공개 API 키 (클라이언트에서 사용 가능)
# 발급: supabase.com → 프로젝트 생성 → Project Settings → API Keys → anon key
NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 역할 키 (관리자, 로컬 환경 + 배치 전용)
# 이 키는 RLS(Row Level Security)를 우회하며, 브라우저에 노출되면 누구든 DB를 수정할 수 있으므로
# 절대 NEXT_PUBLIC_ 접두사를 붙이면 안 됩니다 (Next.js가 클라이언트 번들에 넣어버립니다).
#
# 사용처:
#   - 로컬: npm run refresh, npm run archive, npm run backfill (점수 히스토리 적재)
#   - 배포: 필요 없음 (Vercel에도 설정할 필요 없음)
#   - GitHub Actions: 필수 (스케줄 배치에서 히스토리 적재)
#
# 발급: Supabase → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================================
# 유료 등급 (Free / Pro / Premium) — 아직 켜지 마세요
# ============================================================================
# 비워두거나 "true"가 아니면 모든 방문자가 모든 기능을 씁니다 (현재 사이트 그대로).
# 등급 규칙은 lib/entitlements.ts의 FEATURES 한 곳에 있습니다.
#
# 켜기 전에 반드시:
#   1. supabase/migrations/005_user_entitlements.sql 실행
#   2. 결제 연동 (아직 없음 — 켜면 결제할 방법 없이 기능만 잠깁니다)
#   3. 사업자등록 · 통신판매업 · 유사투자자문업 신고, 시세 데이터 라이선스 (ROADMAP.md 참고)
#
# 서버 전용 변수입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요 — 등급은 서버에서만 결정합니다.
PAYWALL_ENABLED=

# 로컬 개발에서만: 결제·DB 없이 특정 등급으로 화면을 보기 위한 스위치 (free | pro | premium).
# PAYWALL_ENABLED=true일 때만 의미가 있고, 프로덕션 빌드(next start, Vercel)에서는 무시됩니다.
PAYWALL_PREVIEW_TIER=


# ============================================================================
# 데이터 소스 (무료, 공개)
# ============================================================================
# 이 프로젝트는 다음 소스를 사용하며, 모두 무료 + 키 불필요 + 요청 한도 없습니다:
#
#   - SEC EDGAR (미국 증권거래위원회): 상장사 재무제표, 인사이더 거래 신고(Form 4)
#   - Yahoo Finance: 주가, 뉴스
#   - TradingView: 차트 임베드 (퍼블릭)
#   - 위키피디아: 회사 소개
#
# 이들은 모두 라이브러리 내부에서 사용되며, 개별 API 키가 필요 없습니다.


# ============================================================================
# 선택: 테스트/개발 전용
# ============================================================================
# npm run dev 실행 시 아무 환경 변수도 설정하지 않으면,
# data/fixtures.ts의 샘플 데이터(Berkshire, Apple, Microsoft 등 10개 회사)로 실행됩니다.
# 대시보드 상단에 "샘플 데이터" 표시가 나타납니다.
#
# npm run refresh를 실행하면 S&P 500 전체(503개 종목)를 새로 계산해 data/scores.json에 저장합니다.
# (이 명령은 약 30분 소요되며, 환경 변수가 필요 없습니다 — SEC/Yahoo는 공개 인터페이스입니다)

